# Orchestra Backend Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Database Configuration
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=orchestra
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_SYNC=false
DATABASE_LOGGING=false

# Redis Configuration (optional, for distributed mode)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters-long
JWT_EXPIRATION=24h
ENCRYPTION_KEY=your-secure-encryption-key-32-chars
DISABLE_AUTH=false

# SSO Configuration (optional)
SSO_ENABLED=false
SSO_TYPE=saml

# Azure OpenAI Configuration
AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-02-01

# OpenAI Configuration (alternative to Azure)
OPENAI_ENABLED=false
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Vector Store Configuration (optional, for long-term memory)
VECTOR_STORE_ENABLED=false
VECTOR_STORE_TYPE=qdrant
VECTOR_STORE_URL=http://localhost:6333
VECTOR_STORE_API_KEY=

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs
LOG_RETENTION_DAYS=30

# Execution Configuration
MAX_CONCURRENT_WORKFLOWS=100
WORKFLOW_TIMEOUT_MS=300000
NODE_TIMEOUT_MS=60000
MAX_RETRIES=3
ENABLE_CHECKPOINTS=false

# Feature Flags
MARKETPLACE_ENABLED=true
PUBLIC_MARKETPLACE_ENABLED=false
EVALUATION_ENABLED=true
RED_TEAM_TESTING_ENABLED=true
ENABLE_AGENT_MEMORY=true
METRICS_ENABLED=true
